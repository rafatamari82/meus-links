{
  // Cloudflare Workers config. The D1 database below is created automatically
  // on the first deploy (no ID needed).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meus-links",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "meus-links" }
  ],
  // The panel's address. Connect it in Cloudflare (Settings > Domains & Routes > Custom domain).
  // The *.workers.dev address keeps working as a backup way into the panel.
  "triggers": { "crons": ["*/30 * * * *"] },
  "send_email": [ { "name": "EMAIL", "destination_address": "rafatamari82@gmail.com" } ],
  "vars": { "APP_HOST": "app.cutti.us", "EMAIL_TO": "rafatamari82@gmail.com" }
}
